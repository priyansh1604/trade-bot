{
  "name": "zerodha-midcap-trading-bot",
  "version": "0.1.0",
  "description": "Algorithmic intraday trading bot for NSE Nifty Midcap 150 using Zerodha Kite Connect",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postinstall": "patch-package",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "kiteconnect": "^5.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/ws": "^8.5.10",
    "patch-package": "^8.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
