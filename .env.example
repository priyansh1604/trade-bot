# =========================================================
# ZERODHA KITE CONNECT CREDENTIALS
# Get these from https://developers.kite.trade/apps
# NEVER commit the real .env file to Git.
# =========================================================
KITE_API_KEY=
KITE_API_SECRET=
# KITE_ACCESS_TOKEN is generated daily via the login flow (Phase 2).
# It is NOT a long-lived secret you set by hand permanently -
# it will be regenerated each trading day and written here (or loaded at runtime).
# If you DO set it here, the app will use it directly and skip the login flow.
KITE_ACCESS_TOKEN=

# Local redirect server used to auto-capture the daily request_token.
# KITE_REDIRECT_PORT + KITE_REDIRECT_PATH together form the URL that MUST be
# registered exactly as the "Redirect URL" for this app at
# https://developers.kite.trade/apps - e.g. http://127.0.0.1:3000/callback
KITE_REDIRECT_PORT=3000
KITE_REDIRECT_PATH=/callback

# =========================================================
# TRADING MODE / SAFETY SWITCH
# =========================================================
# TRADING_MODE is informational/for logging only.
TRADING_MODE=LIVE

# THE master safety switch. Must be explicitly set to "true" AND
# explicitly requested by the user before any real order is sent.
# Every order-placement function must check this before calling Kite's order API.
LIVE_TRADING_ENABLED=false

# =========================================================
# CAPITAL / RISK PARAMETERS
# =========================================================
CAPITAL_LONG_MAX=5000
CAPITAL_SHORT_MAX=5000
STOP_LOSS_PCT=0.01
TARGET_PCT=0.022
MAX_STOCK_PRICE=5000

# =========================================================
# LIQUIDITY / TRADABILITY FILTER (configurable, not yet calibrated)
# =========================================================
LIQUIDITY_MIN_VALUE=
LIQUIDITY_MAX_SPREAD=
LIQUIDITY_MIN_VOLUME=

# =========================================================
# SCHEDULE (24h, IST, local Mac time assumed to be IST)
# =========================================================
SCHEDULE_START=09:00
SCHEDULE_MARKET_OPEN=09:15
SCHEDULE_SCAN_TIME=09:20
SCHEDULE_ENTRY_TIME=09:21
SCHEDULE_FORCE_EXIT_TIME=15:00

# =========================================================
# LOGGING
# =========================================================
LOG_LEVEL=info
